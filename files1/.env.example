# ─────────────────────────────────────────────
# AutoAnalyst — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Agent tuning
RECURSION_LIMIT=50

# ── Email (required for the "Email this Report" feature) ──────────────────────
# Without these, the Send Report button returns a 503 with a clear message.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your_app_password   ← generate at myaccount.google.com/apppasswords
#   SMTP_FROM=youraddress@gmail.com
#
# For other providers (Outlook, SendGrid, Mailgun) swap host/port accordingly.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com

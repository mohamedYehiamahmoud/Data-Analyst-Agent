# ─────────────────────────────────────────────────────────────────────────────
# AutoAnalyst — Environment Variables
# Copy this file to .env and fill in your values, then restart the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (required) ───────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
RECURSION_LIMIT=50

# ── Email / SMTP (required for "Email this Report") ──────────────────────────
#
# HOW IT WORKS:
#   The SERVER sends emails FROM this account TO whatever address users type.
#   Users never need to configure anything — only you (the developer) set this.
#   Verify your setup at: http://localhost:8000/email-test
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  ⚠️  GMAIL USERS — DO NOT USE YOUR REGULAR PASSWORD                    │
# │                                                                         │
# │  Gmail blocks regular passwords for SMTP. You must generate a           │
# │  16-character App Password:                                             │
# │                                                                         │
# │  1. Enable 2-Step Verification:                                         │
# │     https://myaccount.google.com/security                               │
# │  2. Generate an App Password:                                           │
# │     https://myaccount.google.com/apppasswords                           │
# │     → Select "Mail" + "Other (Custom)" → name it "AutoAnalyst"         │
# │  3. Paste the 16-char password as SMTP_PASSWORD below (spaces OK)       │
# └─────────────────────────────────────────────────────────────────────────┘

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=your_gmail@gmail.com

# ── Other providers ───────────────────────────────────────────────────────────
# Outlook/Hotmail:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Yahoo Mail:       SMTP_HOST=smtp.mail.yahoo.com SMTP_PORT=587
# SendGrid:         SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=<your_api_key>
# Mailgun:          SMTP_HOST=smtp.mailgun.org     SMTP_PORT=587
